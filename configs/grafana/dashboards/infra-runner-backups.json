      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"runner\",fstype!~\"tmpfs|ramfs|overlay|squashfs\"} / node_filesystem_size_bytes{job=\"runner\",fstype!~\"tmpfs|ramfs|overlay|squashfs\"})",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "node_filesystem_size_bytes{job=\"runner\",fstype!~\"tmpfs|ramfs|overlay|squashfs\"}",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "node_filesystem_avail_bytes{job=\"runner\",fstype!~\"tmpfs|ramfs|overlay|squashfs\"}",
          "refId": "C",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "mountpoint",
            "mode": "inner"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "mountpoint",
                "Value #A",
                "Value #B",
                "Value #C"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "mountpoint": "Montare",
              "Value #A": "Ocupat %",
              "Value #B": "Total",
              "Value #C": "Liber"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ocupat %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Liber"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
