      "targets": [
        {
          "expr": "clamp_max(min(node_filesystem_avail_bytes{job=\"runner\",mountpoint=\"/\"}) / clamp_min(-sum(deriv(node_filesystem_avail_bytes{job=\"runner\",mountpoint=\"/\"}[6h])), 1), 31536000)",
