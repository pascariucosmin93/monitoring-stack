      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(100 * (1 - node_filesystem_avail_bytes{job=\"runner\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"runner\",mountpoint=\"/\"}))",
