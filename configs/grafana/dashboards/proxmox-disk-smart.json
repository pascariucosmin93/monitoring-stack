    {
      "id": 11,
      "title": "Toate atributele SMART",
      "description": "Valoarea brută a fiecărui atribut raportat de disc, în ordinea ID-ului SMART.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "{__name__=~\"smartmon_.*_raw_value\",job=\"proxmox-node\"}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "smart_id",
                "__name__",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "smart_id": "ID",
              "__name__": "Atribut",
              "Value": "Valoare brută"
            },
            "indexByName": {
              "smart_id": 0,
              "__name__": 1,
              "Value": 2
            }
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "ID",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 21
