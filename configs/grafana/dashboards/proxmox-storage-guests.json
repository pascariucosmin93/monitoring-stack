{
  "uid": "proxmox-storage-guests",
  "title": "Proxmox — Storage & Guests",
  "tags": [
    "proxmox",
    "storage",
    "vm"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
