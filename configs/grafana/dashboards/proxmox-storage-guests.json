    {
      "id": 15,
      "title": "Invitați Proxmox",
      "description": "Toate VM-urile și containerele (fără template-uri): stare, consum și resurse alocate.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pve_guest_info{template=\"0\"}",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "pve_up{id=~\"(qemu|lxc)/.*\"}",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "100 * pve_cpu_usage_ratio{id=~\"(qemu|lxc)/.*\"}",
          "refId": "C",
          "format": "table",
          "instant": true
        },
        {
          "expr": "pve_memory_usage_bytes{id=~\"(qemu|lxc)/.*\"}",
          "refId": "D",
          "format": "table",
          "instant": true
        },
        {
          "expr": "pve_memory_size_bytes{id=~\"(qemu|lxc)/.*\"}",
          "refId": "E",
          "format": "table",
          "instant": true
        },
        {
          "expr": "pve_uptime_seconds{id=~\"(qemu|lxc)/.*\"}",
          "refId": "F",
          "format": "table",
          "instant": true
        },
        {
          "expr": "pve_disk_size_bytes{id=~\"(qemu|lxc)/.*\"}",
          "refId": "G",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "id",
            "mode": "inner"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "name",
                "type",
                "id",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F",
                "Value #G"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "name": "Nume",
              "type": "Tip",
              "id": "ID",
              "Value #B": "Stare",
              "Value #C": "CPU %",
              "Value #D": "RAM folosită",
              "Value #E": "RAM alocată",
              "Value #F": "Uptime",
              "Value #G": "Disc alocat"
            },
            "indexByName": {
              "name": 0,
              "type": 1,
              "id": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #G": 8
            }
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Stare",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Stare"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Oprit",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Pornit",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM folosită"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM alocată"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Disc alocat"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 0
